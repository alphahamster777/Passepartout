import QtQuick
import QtQuick.Controls
import QtQuick.Controls.Material
import QtQuick.Layouts
import FirebaseAiHelper

// "✨ Generated by AI · 🚩 Report" banner, plus the report dialog it opens.
// Google Play's AI-Generated Content policy requires that users can flag
// offensive AI output from inside the app; this sends the flagged content
// to the report_ai_content Cloud Function (FirebaseAiHelper::reportContent)
// for review. Shown by CreatingRecSet.qml / CreatingRuleSet.qml once they
// hold AI-generated content — set `content` to the generated JSON string
// (empty hides the banner).
Rectangle {
    id: notice

    property string kind: "wordSet"   // "wordSet" | "ruleSet"
    property string theme: ""
    property string content: ""

    visible: content !== ""
    implicitHeight: 42
    radius: 8
    color: "#faf6fc"
    border.color: "#e7d5ef"

    RowLayout {
        anchors { fill: parent; leftMargin: 12; rightMargin: 6 }
        spacing: 8

        Label {
            Layout.fillWidth: true
            text: qsTr("✨ Generated by AI — may contain mistakes")
            font.pixelSize: 12
            color: "#7d3c98"
            elide: Text.ElideRight
        }

        Button {
            flat: true
            implicitHeight: 34
            text: qsTr("🚩 Report")
            font.pixelSize: 12
            font.bold: true
            Material.foreground: "#e74c3c"
            onClicked: reportPopup.open()
        }
    }

    Popup {
        id: reportPopup
        parent: Overlay.overlay
        anchors.centerIn: parent
        width: Math.min(parent ? parent.width - 32 : 340, 380)
        height: Math.min(implicitHeight, parent ? parent.height - 40 : 600)
        padding: 0
        modal: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside

        property string selectedReason: ""
        property string statusText: ""
        property bool sent: false

        onOpened: {
            selectedReason = ""
            statusText = ""
            sent = false
            commentField.text = ""
        }

        background: Rectangle { radius: 14; color: "white"; layer.enabled: true }

        Connections {
            target: FirebaseAiHelper
            function onReportSent() {
                reportPopup.sent = true
                reportPopup.statusText = qsTr("Thank you — your report was sent and will be reviewed.")
            }
            function onReportFailed(error) {
                reportPopup.statusText = qsTr("Couldn't send the report: %1").arg(error)
            }
        }

        contentItem: ScrollView {
            id: reportScroll
            clip: true
            contentWidth: availableWidth

            Column {
                width: reportScroll.availableWidth

                Rectangle {
                    width: parent.width
                    height: 52
                    color: "#2c3e50"
                    radius: 14
                    Rectangle {
                        anchors { bottom: parent.bottom; left: parent.left; right: parent.right }
                        height: 14; color: "#2c3e50"
                    }
                    Label {
                        anchors.centerIn: parent
                        text: qsTr("🚩 Report AI content")
                        font.pixelSize: 16; font.bold: true; color: "white"
                    }
                }

                Column {
                    width: parent.width
                    padding: 16
                    spacing: 6

                    Label {
                        width: parent.width - 32
                        visible: !reportPopup.sent
                        text: qsTr("What's wrong with this generated content?")
                        font.pixelSize: 13
                        color: "#2c3e50"
                        wrapMode: Text.WordWrap
                    }

                    Repeater {
                        model: [
                            { key: "sexual",     label: qsTr("Sexual or suggestive content") },
                            { key: "profanity",  label: qsTr("Profanity or offensive language") },
                            { key: "hateful",    label: qsTr("Hateful or harassing content") },
                            { key: "violent",    label: qsTr("Violent or dangerous content") },
                            { key: "inaccurate", label: qsTr("Wrong or misleading information") },
                            { key: "other",      label: qsTr("Something else") }
                        ]
                        delegate: RadioButton {
                            required property var modelData
                            visible: !reportPopup.sent
                            text: modelData.label
                            font.pixelSize: 13
                            checked: reportPopup.selectedReason === modelData.key
                            onClicked: reportPopup.selectedReason = modelData.key
                            Material.accent: "#e74c3c"
                        }
                    }

                    TextField {
                        id: commentField
                        width: parent.width - 32
                        visible: !reportPopup.sent
                        placeholderText: qsTr("Details (optional)")
                        maximumLength: 1000
                        font.pixelSize: 13
                    }

                    Label {
                        width: parent.width - 32
                        visible: reportPopup.statusText !== ""
                        text: reportPopup.statusText
                        font.pixelSize: 12
                        color: reportPopup.sent ? "#27ae60" : "#e74c3c"
                        wrapMode: Text.WordWrap
                    }

                    RowLayout {
                        width: parent.width - 32
                        visible: FirebaseAiHelper.reporting
                        spacing: 8
                        BusyIndicator {
                            running: FirebaseAiHelper.reporting
                            implicitWidth: 22; implicitHeight: 22
                        }
                        Label { text: qsTr("Sending…"); font.pixelSize: 12; color: "#7f8c8d" }
                    }
                }

                Rectangle { width: parent.width; height: 1; color: "#ececec" }

                Row {
                    width: parent.width
                    ItemDelegate {
                        width: reportPopup.sent ? parent.width : parent.width / 2
                        height: 50
                        background: Rectangle { color: parent.pressed ? "#f0f4f8" : "white"; radius: 14 }
                        contentItem: Text {
                            text: reportPopup.sent ? qsTr("Close") : qsTr("Cancel")
                            color: "#7f8c8d"
                            font.pixelSize: 15; font.bold: true
                            horizontalAlignment: Text.AlignHCenter
                            verticalAlignment: Text.AlignVCenter
                        }
                        onClicked: reportPopup.close()
                    }
                    ItemDelegate {
                        id: sendReportButton
                        visible: !reportPopup.sent
                        width: parent.width / 2
                        height: 50
                        enabled: reportPopup.selectedReason !== "" && !FirebaseAiHelper.reporting
                        background: Rectangle {
                            radius: 14
                            color: !sendReportButton.enabled ? "#bbb"
                                 : sendReportButton.pressed ? "#c0392b" : "#e74c3c"
                        }
                        contentItem: Text {
                            text: qsTr("Send report")
                            color: "white"
                            font.pixelSize: 15; font.bold: true
                            horizontalAlignment: Text.AlignHCenter
                            verticalAlignment: Text.AlignVCenter
                        }
                        onClicked: {
                            reportPopup.statusText = ""
                            FirebaseAiHelper.reportContent(notice.kind, notice.theme, notice.content,
                                                           reportPopup.selectedReason, commentField.text)
                        }
                    }
                }
            }
        }
    }
}
