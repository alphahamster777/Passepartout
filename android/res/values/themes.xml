<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Edge-to-edge is mandatory for apps targeting API 36 — the opt-out attribute
        that worked at API 35 (windowOptOutEdgeToEdgeEnforcement) is ignored from here
        on, on every device regardless of its own Android version. Insets are instead
        handled explicitly in QML via the Qt 6.9+ SafeArea attached property.

        Our headers/footers are always the dark navy (#2c3e50), so system bar icons
        must be light/white rather than following the device's own light/dark theme.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
