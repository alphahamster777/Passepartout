<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup/device-transfer rules.

    Qt's QSettings (used by FirebaseAiHelper to cache the Firebase Auth
    refresh token) resolves to the same Unix-style path logic Qt uses on
    Linux: files/.config/<Organization>/<Application> under the app's
    private storage. Without this exclusion, Android's "copy data from old
    device" transfer during new-phone setup — which works independently of
    which Google account the new device signs into — silently carries that
    cached token over, so a fresh install on a new phone reuses the old
    phone's Firebase identity (and its already-used AI-generation quota)
    instead of starting fresh.

    Word sets themselves live under QStandardPaths::AppDataLocation, a
    different path this exclusion does not touch, so migrating to a new
    phone still carries over the user's actual vocabulary data — only the
    quota identity resets.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="files/.config/Passepartout"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="files/.config/Passepartout"/>
    </device-transfer>
</data-extraction-rules>
