<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alphahamster.passepartout"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">

    <!-- Required for Wikimedia image fetch and any HTTP(S) requests -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Required for microphone recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Required for camera capture -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- Qt module permissions are injected here by androiddeployqt -->
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true"/>

    <!-- QtActivity only implements the legacy onBackPressed() dispatch, not
         OnBackInvokedCallback, so predictive back must stay off at API 36+
         or Qt's own Keys.onReleased(Qt.Key_Back) handling in QML stops firing. -->
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:fullBackupOnly="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false">

        <!-- launchMode="singleTask" makes a cross-app VIEW intent (e.g.
             tapping a .ppset in Telegram) route to the existing instance via
             onNewIntent() instead of a fresh Activity, which onNewIntent()
             relies on to see the new intent at all.
             taskAffinity="" was tried on top of this to stop Android from
             also visually nesting a second entry under the calling app's own
             task in Recents — but that combination is a known, documented
             Android gotcha: it breaks the launcher icon's own task-affinity
             matching, causing the app to hang on relaunch after being opened
             via a deep link. Reverted; the Recents double-entry is cosmetic
             and not worth that trade. -->
        <activity
            android:name="com.alphahamster.passepartout.PassepartoutActivity"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Open .ppset files shared with our custom MIME type -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/x-ppset"/>
            </intent-filter>
            <!-- Fallback: messengers that label the file as application/zip -->
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/zip"/>
            </intent-filter>
            <!-- Fallback: Telegram and most messengers use octet-stream for unknown extensions -->
            <intent-filter android:priority="5">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Fallback: file-manager apps opening via file:// URI with .ppset extension -->
            <intent-filter android:priority="5">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ppset"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <!-- Google Sign-In OAuth redirect (see GoogleSignInHelper) — the
                 "iOS"-type client's documented reversed-client-ID scheme.
                 launchMode="singleTask" above means this arrives via
                 onNewIntent() rather than a fresh Activity instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.googleusercontent.apps.675677561526-ggr3uedrnqv9u0a8kaduk14hhu52esf1"
                      android:path="/oauth2redirect"/>
            </intent-filter>
            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --"/>
            <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --"/>
        </activity>

        <!-- Qt's built-in FileProvider used for sharing local files (e.g. .ppset bundles).
             Authority is <packageName>.qtprovider; paths are configured in qtprovider_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>

    </application>
</manifest>
