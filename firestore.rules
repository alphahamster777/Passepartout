rules_version = '2';

// The usage counters here are only ever read/written by
// functions/main.py through the Admin SDK, which bypasses these rules
// entirely — so client access can (and should) be locked down completely.
// Nothing in this database is meant to be reachable directly from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
